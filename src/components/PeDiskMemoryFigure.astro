---
import FigureFrame from './FigureFrame.astro';

interface Props {
  label?: string;
}

const { label = 'hello.exe · on disk vs in memory' } = Astro.props;
---

<FigureFrame label={label}>
  <svg
    viewBox="0 0 936 560"
    role="img"
    aria-label="A PE binary's on-disk layout compared with its in-memory image. On disk every section is packed to a 512-byte FileAlignment starting at PointerToRawData. In memory each section is mapped at ImageBase plus its VirtualAddress, rounded up to the 4096-byte SectionAlignment, which opens slack between sections. The headers are mapped too. The .data section's VirtualSize exceeds its SizeOfRawData, and the loader zero-fills the difference, which is how PE expresses uninitialized data. The .reloc section is marked discardable and may be dropped after the loader applies base relocations."
  >
    <defs>
      <marker
        id="pd-arrow"
        markerUnits="userSpaceOnUse"
        markerWidth="9"
        markerHeight="9"
        refX="8.5"
        refY="4.5"
        orient="auto"
      >
        <path d="M0,0 L9,4.5 L0,9 Z" class="arrow-head"></path>
      </marker>
      <pattern id="pd-grid" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1" class="grid-dot"></circle>
      </pattern>
    </defs>

    <rect x="0" y="0" width="936" height="560" fill="url(#pd-grid)"></rect>

    <text class="col-head" x="212" y="34">ON DISK · FileAlignment 0x200</text>
    <text class="col-head" x="700" y="34">IN MEMORY · SectionAlignment 0x1000</text>
    <text class="axis" x="212" y="50">PointerToRawData</text>
    <text class="axis" x="700" y="50">ImageBase 0x140000000 + VirtualAddress</text>

    <!-- ON DISK column -->
    <rect class="box hdr" x="92" y="64" width="240" height="34" rx="4"></rect>
    <text class="sect" x="212" y="86">headers · 0x400</text>

    <rect class="box code" x="92" y="98" width="240" height="120" rx="4"></rect>
    <text class="sect lbl-red" x="212" y="146">.text</text>
    <text class="meta" x="212" y="164">raw 0x14e00 @ 0x400</text>

    <rect class="box rdata" x="92" y="218" width="240" height="92" rx="4"></rect>
    <text class="sect lbl-amber" x="212" y="256">.rdata</text>
    <text class="meta" x="212" y="274">raw 0xa800 @ 0x15200</text>

    <rect class="box data" x="92" y="310" width="240" height="40" rx="4"></rect>
    <text class="sect lbl-blue" x="212" y="330">.data</text>
    <text class="meta" x="212" y="344">raw 0xc00 @ 0x1fa00</text>

    <rect class="box misc" x="92" y="350" width="240" height="34" rx="4"></rect>
    <text class="sect" x="212" y="371">.pdata · raw 0x1400</text>

    <rect class="box misc" x="92" y="384" width="240" height="28" rx="4"></rect>
    <text class="sect" x="212" y="402">.fptable · raw 0x200</text>

    <rect class="box reloc" x="92" y="412" width="240" height="30" rx="4"></rect>
    <text class="sect lbl-teal" x="212" y="431">.reloc · raw 0x800</text>

    <text class="total" x="212" y="464">file size 140,288 bytes · nothing wasted</text>

    <!-- IN MEMORY column -->
    <rect class="box hdr" x="580" y="64" width="240" height="34" rx="4"></rect>
    <text class="sect" x="700" y="86">headers @ +0x0</text>

    <rect class="box code" x="580" y="102" width="240" height="120" rx="4"></rect>
    <text class="sect lbl-red" x="700" y="150">.text</text>
    <text class="meta" x="700" y="168">0x140001000 · r-x</text>

    <rect class="box rdata" x="580" y="230" width="240" height="92" rx="4"></rect>
    <text class="sect lbl-amber" x="700" y="268">.rdata</text>
    <text class="meta" x="700" y="286">0x140016000 · r-- · holds the IAT</text>

    <rect class="box data" x="580" y="330" width="240" height="56" rx="4"></rect>
    <text class="sect lbl-blue" x="700" y="350">.data</text>
    <text class="meta" x="700" y="364">0x140021000 · rw-</text>
    <rect class="zerofill" x="584" y="368" width="232" height="14" rx="2"></rect>
    <text class="zf-text" x="700" y="379">virt 0x1be0 &gt; raw 0xc00 → zero-filled</text>

    <rect class="box misc" x="580" y="394" width="240" height="34" rx="4"></rect>
    <text class="sect" x="700" y="415">.pdata @ 0x140023000</text>

    <rect class="box misc" x="580" y="436" width="240" height="28" rx="4"></rect>
    <text class="sect" x="700" y="454">.fptable @ 0x140025000</text>

    <rect class="box reloc reloc-mem" x="580" y="472" width="240" height="30" rx="4"></rect>
    <text class="sect lbl-teal" x="700" y="491">.reloc · DISCARDABLE</text>

    <text class="total" x="700" y="524">SizeOfImage 0x27000 · gaps are alignment slack</text>

    <!-- mapping arrows -->
    <line class="map" x1="336" y1="81" x2="576" y2="81" marker-end="url(#pd-arrow)"></line>
    <line class="map" x1="336" y1="158" x2="576" y2="162" marker-end="url(#pd-arrow)"></line>
    <line class="map" x1="336" y1="264" x2="576" y2="276" marker-end="url(#pd-arrow)"></line>
    <line class="map" x1="336" y1="330" x2="576" y2="350" marker-end="url(#pd-arrow)"></line>
    <line class="map" x1="336" y1="367" x2="576" y2="411" marker-end="url(#pd-arrow)"></line>
    <line class="map" x1="336" y1="398" x2="576" y2="450" marker-end="url(#pd-arrow)"></line>
    <line class="map" x1="336" y1="427" x2="576" y2="487" marker-end="url(#pd-arrow)"></line>

    <!-- alignment slack marker between .text and .rdata in memory -->
    <line class="slack-line" x1="824" y1="226" x2="836" y2="226"></line>
    <text class="slack-text" x="840" y="229">alignment slack</text>

    <text class="key" x="468" y="548">
      same bytes, two different address spaces; the section table is the only map to either
    </text>
  </svg>
  <span slot="caption">
    On disk sections are packed to 512 bytes; in memory they are spread to 4 KB pages at
    ImageBase + RVA. <code>.data</code> is where PE hides uninitialized data: VirtualSize exceeds
    SizeOfRawData and the loader zero-fills the rest, the job ELF gives to <code>.bss</code>.
  </span>
</FigureFrame>

<style>
  text {
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    text-anchor: middle;
  }

  .grid-dot {
    fill: var(--border);
    opacity: 0.5;
  }

  .col-head {
    fill: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .axis {
    fill: var(--text-faint);
    font-size: 9.5px;
  }

  .box {
    fill: var(--bg-1);
    stroke-width: 1.25;
    stroke-opacity: 0.8;
  }

  .box.hdr {
    stroke: var(--border);
    stroke-opacity: 1;
  }

  .box.code {
    stroke: var(--red-soft);
  }

  .box.rdata {
    stroke: var(--amber);
  }

  .box.data {
    stroke: var(--blue);
  }

  .box.misc {
    stroke: var(--border);
    stroke-opacity: 1;
  }

  .box.reloc {
    stroke: var(--teal);
  }

  .reloc-mem {
    stroke-dasharray: 5 3;
  }

  .sect {
    fill: var(--text);
    font-size: 11.5px;
  }

  .lbl-red {
    fill: var(--red-soft);
  }

  .lbl-amber {
    fill: var(--amber);
  }

  .lbl-blue {
    fill: var(--blue);
  }

  .lbl-teal {
    fill: var(--teal);
  }

  .meta {
    fill: var(--text-faint);
    font-size: 9.5px;
  }

  .zerofill {
    fill: var(--bg-2);
    stroke: var(--blue);
    stroke-width: 1;
    stroke-dasharray: 3 2;
    stroke-opacity: 0.8;
  }

  .zf-text {
    fill: var(--blue);
    font-size: 9px;
  }

  .total {
    fill: var(--text-faint);
    font-size: 10px;
  }

  .map {
    stroke: var(--text-faint);
    stroke-width: 1.25;
    stroke-opacity: 0.55;
    stroke-dasharray: 4 3;
  }

  .slack-line {
    stroke: var(--text-faint);
    stroke-width: 1;
  }

  .slack-text {
    fill: var(--text-faint);
    font-size: 9.5px;
    text-anchor: start;
  }

  .key {
    fill: var(--text-muted);
    font-size: 10.5px;
  }

  .arrow-head {
    fill: var(--text-faint);
    fill-opacity: 0.7;
  }
</style>
