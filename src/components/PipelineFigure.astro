---
import FigureFrame from './FigureFrame.astro';

interface Props {
  label?: string;
}

const { label = 'fig 1-1 · the c compilation process' } = Astro.props;
---

<FigureFrame label={label}>
  <svg
    viewBox="0 0 936 304"
    role="img"
    aria-label="The C compilation process. Source files file-1.c through file-n.c, plus header.h files, feed the C preprocessor. Preprocessed code goes to the C/C++ compiler, then the assembler, which emits the object files file-1.o through file-n.o. The linker combines the object files with library.a static libraries into the binary executable a.out."
  >
    <defs>
      <marker
        id="pf-arrow"
        markerUnits="userSpaceOnUse"
        markerWidth="9"
        markerHeight="9"
        refX="8.5"
        refY="4.5"
        orient="auto"
      >
        <path d="M0,0 L9,4.5 L0,9 Z" class="arrow-head"></path>
      </marker>
      <pattern id="pf-grid" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1" class="grid-dot"></circle>
      </pattern>
    </defs>

    <rect x="0" y="0" width="936" height="304" fill="url(#pf-grid)"></rect>

    <!-- source files -->
    <g>
      <rect class="box-artifact" x="16" y="143" width="96" height="30" rx="5"></rect>
      <text class="file-name" x="64" y="162">file-1.c</text>
      <rect class="box-artifact" x="16" y="181" width="96" height="30" rx="5"></rect>
      <text class="file-name" x="64" y="200">file-2.c</text>
      <circle class="stack-dot" cx="64" cy="220" r="1.4"></circle>
      <circle class="stack-dot" cx="64" cy="227" r="1.4"></circle>
      <circle class="stack-dot" cx="64" cy="234" r="1.4"></circle>
      <rect class="box-artifact" x="16" y="243" width="96" height="30" rx="5"></rect>
      <text class="file-name" x="64" y="262">file-n.c</text>
      <text class="group-label" x="64" y="294">SOURCE</text>
    </g>

    <!-- header.h stack, auxiliary input to the preprocessor -->
    <g>
      <rect class="box-artifact" x="172" y="44" width="88" height="30" rx="5"></rect>
      <rect class="box-artifact" x="168" y="48" width="88" height="30" rx="5"></rect>
      <rect class="box-artifact" x="164" y="52" width="88" height="30" rx="5"></rect>
      <text class="file-name" x="208" y="71">header.h</text>
      <line class="flow flow-aux" x1="208" y1="86" x2="208" y2="165" marker-end="url(#pf-arrow)"></line>
    </g>

    <!-- stage: preprocessing -->
    <rect class="box-proc proc-teal" x="152" y="168" width="112" height="56" rx="6"></rect>
    <text class="proc-label lbl-teal" x="208" y="192">C</text>
    <text class="proc-label lbl-teal" x="208" y="208">preprocessor</text>
    <text class="tool-hint" x="208" y="240">cpp</text>

    <!-- stage: compilation -->
    <rect class="box-proc proc-amber" x="304" y="168" width="96" height="56" rx="6"></rect>
    <text class="proc-label lbl-amber" x="352" y="192">C/C++</text>
    <text class="proc-label lbl-amber" x="352" y="208">compiler</text>
    <text class="tool-hint" x="352" y="240">cc1</text>

    <!-- stage: assembly -->
    <rect class="box-proc proc-blue" x="440" y="168" width="100" height="56" rx="6"></rect>
    <text class="proc-label lbl-blue" x="490" y="200">assembler</text>
    <text class="tool-hint" x="490" y="240">as</text>

    <!-- object files -->
    <g>
      <rect class="box-artifact" x="580" y="143" width="96" height="30" rx="5"></rect>
      <text class="file-name" x="628" y="162">file-1.o</text>
      <rect class="box-artifact" x="580" y="181" width="96" height="30" rx="5"></rect>
      <text class="file-name" x="628" y="200">file-2.o</text>
      <circle class="stack-dot" cx="628" cy="220" r="1.4"></circle>
      <circle class="stack-dot" cx="628" cy="227" r="1.4"></circle>
      <circle class="stack-dot" cx="628" cy="234" r="1.4"></circle>
      <rect class="box-artifact" x="580" y="243" width="96" height="30" rx="5"></rect>
      <text class="file-name" x="628" y="262">file-n.o</text>
      <text class="group-label" x="628" y="294">OBJECT FILES</text>
    </g>

    <!-- library.a stack, auxiliary input to the linker -->
    <g>
      <rect class="box-artifact" x="722" y="44" width="88" height="30" rx="5"></rect>
      <rect class="box-artifact" x="718" y="48" width="88" height="30" rx="5"></rect>
      <rect class="box-artifact" x="714" y="52" width="88" height="30" rx="5"></rect>
      <text class="file-name" x="758" y="71">library.a</text>
      <line class="flow flow-aux" x1="758" y1="86" x2="758" y2="165" marker-end="url(#pf-arrow)"></line>
    </g>

    <!-- stage: linking -->
    <rect class="box-proc proc-red" x="716" y="168" width="84" height="56" rx="6"></rect>
    <text class="proc-label lbl-red" x="758" y="200">linker</text>
    <text class="tool-hint" x="758" y="240">ld</text>

    <!-- final binary -->
    <rect class="box-final" x="840" y="181" width="80" height="30" rx="5"></rect>
    <text class="final-name" x="880" y="200">a.out</text>
    <text class="group-label" x="880" y="240">BINARY</text>
    <text class="group-label" x="880" y="256">EXECUTABLE</text>

    <!-- main flow -->
    <line class="flow" x1="112" y1="196" x2="150" y2="196" marker-end="url(#pf-arrow)"></line>
    <line class="flow" x1="264" y1="196" x2="302" y2="196" marker-end="url(#pf-arrow)"></line>
    <line class="flow" x1="400" y1="196" x2="438" y2="196" marker-end="url(#pf-arrow)"></line>
    <line class="flow" x1="540" y1="196" x2="578" y2="196" marker-end="url(#pf-arrow)"></line>
    <line class="flow" x1="676" y1="196" x2="714" y2="196" marker-end="url(#pf-arrow)"></line>
    <line class="flow" x1="800" y1="196" x2="838" y2="196" marker-end="url(#pf-arrow)"></line>
  </svg>
  <span slot="caption">
    Four phases: preprocessing, compilation, assembly, linking. Redrawn from fig. 1-1 of
    <em>Practical Binary Analysis</em>.
  </span>
</FigureFrame>

<style>
  text {
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    text-anchor: middle;
  }

  .grid-dot {
    fill: var(--border);
    opacity: 0.5;
  }

  .box-artifact {
    fill: var(--bg-1);
    stroke: var(--border);
    stroke-width: 1;
  }

  .file-name {
    fill: var(--green);
    font-size: 12px;
  }

  .stack-dot {
    fill: var(--text-faint);
  }

  .box-proc {
    fill: var(--bg-1);
    stroke-width: 1.25;
    stroke-opacity: 0.75;
  }

  .proc-teal {
    stroke: var(--teal);
  }

  .proc-amber {
    stroke: var(--amber);
  }

  .proc-blue {
    stroke: var(--blue);
  }

  .proc-red {
    stroke: var(--red-soft);
  }

  .proc-label {
    font-size: 13px;
    font-weight: 600;
  }

  .lbl-teal {
    fill: var(--teal);
  }

  .lbl-amber {
    fill: var(--amber);
  }

  .lbl-blue {
    fill: var(--blue);
  }

  .lbl-red {
    fill: var(--red-soft);
  }

  .tool-hint {
    fill: var(--text-faint);
    font-size: 10px;
  }

  .group-label {
    fill: var(--text-faint);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .box-final {
    fill: var(--red-dim);
    stroke: var(--red-soft);
    stroke-width: 1.25;
  }

  .final-name {
    fill: var(--text);
    font-size: 13px;
    font-weight: 600;
  }

  .flow {
    stroke: var(--text-faint);
    stroke-width: 1.5;
  }

  .flow-aux {
    stroke-dasharray: 4 3;
  }

  .arrow-head {
    fill: var(--text-faint);
  }
</style>
