---
import FigureFrame from './FigureFrame.astro';

interface Props {
  label?: string;
}

const { label = 'the comparison loop · and where to break' } = Astro.props;
---

<FigureFrame label={label}>
  <svg
    viewBox="0 0 936 440"
    role="img"
    aria-label="The hand-rolled byte comparison loop that checks the GUESSME environment variable. Register rbx points at the attacker-controlled environment string, rcx points at the decrypted ground-truth string, rax is the loop index and rsi holds the expected length. The loop loads a byte from rbx plus rax, tests it for NUL, and compares it against the byte at rcx plus rax. A mismatch or an early NUL jumps to the failure path which prints guess again. Reaching the full length jumps to the success path which decrypts and prints the flag. Because rcx points at a buffer that only exists after runtime decryption, setting a breakpoint on the compare instruction and dumping rcx reveals the expected value."
  >
    <defs>
      <marker
        id="gl-arrow"
        markerUnits="userSpaceOnUse"
        markerWidth="9"
        markerHeight="9"
        refX="8.5"
        refY="4.5"
        orient="auto"
      >
        <path d="M0,0 L9,4.5 L0,9 Z" class="arrow-head"></path>
      </marker>
      <marker
        id="gl-arrow-red"
        markerUnits="userSpaceOnUse"
        markerWidth="9"
        markerHeight="9"
        refX="8.5"
        refY="4.5"
        orient="auto"
      >
        <path d="M0,0 L9,4.5 L0,9 Z" class="arrow-head-red"></path>
      </marker>
      <pattern id="gl-grid" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1" class="grid-dot"></circle>
      </pattern>
    </defs>

    <rect x="0" y="0" width="936" height="440" fill="url(#gl-grid)"></rect>

    <!-- register legend -->
    <rect class="box reg" x="580" y="30" width="320" height="126" rx="6"></rect>
    <text class="rtitle lbl-teal" x="596" y="52">the four values that matter</text>
    <text class="rline" x="596" y="76">rbx</text>
    <text class="rdesc" x="640" y="76">→ your GUESSME string</text>
    <text class="rline" x="596" y="96">rcx</text>
    <text class="rdesc hot" x="640" y="96">→ the decrypted ground truth</text>
    <text class="rline" x="596" y="116">rax</text>
    <text class="rdesc" x="640" y="116">→ loop index i</text>
    <text class="rline" x="596" y="136">0x15</text>
    <text class="rdesc" x="640" y="136">→ expected length (21)</text>

    <!-- the loop -->
    <rect class="box code" x="40" y="30" width="500" height="230" rx="6"></rect>
    <text class="asm" x="56" y="54">400dc0:  movzx  edx,BYTE PTR [rbx+rax*1]</text>
    <text class="cmt" x="330" y="54">load your byte</text>
    <text class="asm" x="56" y="72">400dc4:  test   dl,dl</text>
    <text class="cmt" x="330" y="72">NUL = too short</text>

    <text class="asm" x="56" y="96">400dc6:  je     400dcd</text>
    <text class="cmt" x="330" y="96">ran out → fail</text>

    <rect class="brk" x="50" y="106" width="480" height="22" rx="4"></rect>
    <text class="asm hot" x="56" y="122">400dc8:  cmp    dl,BYTE PTR [rcx+rax*1]</text>
    <text class="cmt hotc" x="330" y="122">← break here</text>

    <text class="asm" x="56" y="146">400dcb:  je     400de0</text>
    <text class="cmt ok" x="330" y="146">match → keep going</text>
    <text class="asm dim" x="56" y="164">400dcd:  mov    edi,0x4011af</text>
    <text class="cmt" x="330" y="164">"guess again!"</text>
    <text class="asm dim" x="56" y="182">400dd2:  call   400ab0 &lt;puts@plt&gt;</text>
    <text class="asm" x="56" y="206">400de0:  add    rax,0x1</text>
    <text class="cmt" x="330" y="206">i++</text>
    <text class="asm" x="56" y="224">400de4:  cmp    rax,0x15</text>
    <text class="cmt" x="330" y="224">all 21 bytes done?</text>
    <text class="asm" x="56" y="242">400de8:  jne    400dc0</text>
    <text class="cmt" x="330" y="242">loop back</text>

    <!-- back-edge: jne 400de8 -> loop top 400dc0 -->
    <path class="flow" d="M40,238 L28,238 L28,50 L46,50" marker-end="url(#gl-arrow)"></path>

    <!-- fail -->
    <rect class="box fail" x="40" y="286" width="240" height="60" rx="6"></rect>
    <text class="rtitle lbl-red" x="56" y="308">failure path</text>
    <text class="rdesc" x="56" y="328">puts("guess again!")</text>

    <!-- success -->
    <rect class="box ok-box" x="300" y="286" width="240" height="60" rx="6"></rect>
    <text class="rtitle lbl-green" x="316" y="308">success path · 400dea</text>
    <text class="rdesc" x="316" y="328">rc4_decrypt → printf("flag = %s")</text>

    <line class="flow" x1="120" y1="262" x2="120" y2="282" marker-end="url(#gl-arrow)"></line>
    <line class="flow" x1="420" y1="262" x2="420" y2="282" marker-end="url(#gl-arrow)"></line>

    <!-- gdb panel -->
    <rect class="box gdb" x="580" y="176" width="320" height="170" rx="6"></rect>
    <text class="rtitle lbl-red" x="596" y="198">why ltrace could not see this</text>
    <text class="rdesc2" x="596" y="218">It is a hand-written byte loop, not</text>
    <text class="rdesc2" x="596" y="234">strcmp. No library call = no ltrace line.</text>
    <text class="rdesc2" x="596" y="254">And rcx points at a buffer that only</text>
    <text class="rdesc2" x="596" y="270">exists after runtime decryption, so</text>
    <text class="rdesc2" x="596" y="286">strings and objdump cannot reach it.</text>
    <text class="gcmd" x="596" y="312">(gdb) break *0x400dc8</text>
    <text class="gcmd" x="596" y="328">(gdb) x/s $rcx</text>
    <text class="gout lbl-green" x="596" y="344">"Crackers Don't Matter"</text>

    <path class="flow flow-red" d="M534,117 L560,117 L560,300 L576,300" marker-end="url(#gl-arrow-red)"></path>

    <text class="foot" x="468" y="378">
      static analysis narrows it to one instruction; dynamic analysis reads the answer out of a register
    </text>
    <text class="foot dimf" x="468" y="400">
      encrypt a comparison and only the runtime knows the truth
    </text>
  </svg>
  <span slot="caption">
    The check that <code>ltrace</code> is blind to. Once <code>objdump</code> locates the compare
    at <code>0x400dc8</code>, a single <code>gdb</code> breakpoint and <code>x/s $rcx</code> dumps
    the value the program is comparing against.
  </span>
</FigureFrame>

<style>
  text {
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    text-anchor: start;
  }

  .grid-dot {
    fill: var(--border);
    opacity: 0.5;
  }

  .box {
    fill: var(--bg-1);
    stroke-width: 1.25;
    stroke-opacity: 0.8;
  }

  .box.code {
    stroke: var(--border);
    stroke-opacity: 1;
    fill: var(--bg-2);
  }
  .box.reg {
    stroke: var(--teal);
  }
  .box.gdb {
    stroke: var(--red-soft);
  }
  .box.fail {
    stroke: var(--red-soft);
    stroke-opacity: 0.6;
  }
  .box.ok-box {
    stroke: var(--green);
    stroke-opacity: 0.7;
  }

  .brk {
    fill: var(--bg-1);
    stroke: var(--red-soft);
    stroke-width: 1.25;
  }

  .asm {
    fill: var(--text);
    font-size: 11px;
  }

  .asm.dim {
    fill: var(--text-faint);
  }

  .asm.hot {
    fill: var(--red-soft);
    font-weight: 600;
  }

  .cmt {
    fill: var(--text-faint);
    font-size: 9.5px;
  }

  .cmt.hotc {
    fill: var(--red-soft);
  }

  .cmt.ok {
    fill: var(--green);
  }

  .rtitle {
    font-size: 12px;
    font-weight: 600;
  }

  .lbl-teal {
    fill: var(--teal);
  }
  .lbl-red {
    fill: var(--red-soft);
  }
  .lbl-green {
    fill: var(--green);
  }

  .rline {
    fill: var(--amber);
    font-size: 11px;
  }

  .rdesc {
    fill: var(--text-muted);
    font-size: 10.5px;
  }

  .rdesc.hot {
    fill: var(--red-soft);
  }

  .rdesc2 {
    fill: var(--text-muted);
    font-size: 10px;
  }

  .gcmd {
    fill: var(--text);
    font-size: 10.5px;
  }

  .gout {
    font-size: 11px;
    font-weight: 600;
  }

  .flow {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.5;
  }

  .flow-red {
    stroke: var(--red-soft);
    stroke-dasharray: 4 3;
    stroke-opacity: 0.8;
  }

  .foot {
    fill: var(--text-muted);
    font-size: 10.5px;
    text-anchor: middle;
  }

  .foot.dimf {
    fill: var(--text-faint);
    font-size: 10px;
  }

  .arrow-head {
    fill: var(--text-faint);
  }

  .arrow-head-red {
    fill: var(--red-soft);
  }
</style>
