---
import FigureFrame from './FigureFrame.astro';

interface Props {
  label?: string;
}

const { label = 'one interface, every format' } = Astro.props;
---

<FigureFrame label={label}>
  <svg
    viewBox="0 0 936 420"
    role="img"
    aria-label="The layers between an analysis tool and a binary file on disk. At the top sits the analysis tool, loader_demo. Below it the loader's own format-agnostic API of Binary, Section and Symbol objects. Below that libbfd, which exposes generic bfd, asection and asymbol structures and a family of bfd underscore functions. Below libbfd sit its per-format back-ends for elf64-x86-64, pei-x86-64, elf32-i386 and many others, and at the bottom the actual files on disk. The point is that adding a new format means libbfd gains a back-end while the tool above changes nothing."
  >
    <defs>
      <marker
        id="ls-arrow"
        markerUnits="userSpaceOnUse"
        markerWidth="9"
        markerHeight="9"
        refX="8.5"
        refY="4.5"
        orient="auto"
      >
        <path d="M0,0 L9,4.5 L0,9 Z" class="arrow-head"></path>
      </marker>
      <pattern id="ls-grid" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1" class="grid-dot"></circle>
      </pattern>
    </defs>

    <rect x="0" y="0" width="936" height="420" fill="url(#ls-grid)"></rect>

    <!-- analysis tool -->
    <rect class="box proc-green" x="150" y="26" width="470" height="46" rx="6"></rect>
    <text class="title lbl-green" x="385" y="46">your analysis tool</text>
    <text class="sub" x="385" y="63">loader_demo.cc · knows nothing about ELF or PE</text>

    <!-- loader API -->
    <rect class="box proc-teal" x="150" y="92" width="470" height="76" rx="6"></rect>
    <text class="title lbl-teal" x="385" y="112">the loader API · inc/loader.h</text>
    <g>
      <rect class="chip" x="176" y="122" width="126" height="22" rx="4"></rect>
      <text class="chip-text lbl-teal" x="239" y="137">Binary</text>
      <rect class="chip" x="322" y="122" width="126" height="22" rx="4"></rect>
      <text class="chip-text lbl-teal" x="385" y="137">Section</text>
      <rect class="chip" x="468" y="122" width="126" height="22" rx="4"></rect>
      <text class="chip-text lbl-teal" x="531" y="137">Symbol</text>
    </g>
    <text class="sub" x="385" y="160">load_binary() · unload_binary()</text>

    <!-- libbfd -->
    <rect class="box proc-amber" x="150" y="188" width="470" height="90" rx="6"></rect>
    <text class="title lbl-amber" x="385" y="208">libbfd · /usr/include/bfd.h</text>
    <g>
      <rect class="chip" x="176" y="218" width="126" height="22" rx="4"></rect>
      <text class="chip-text lbl-amber" x="239" y="233">bfd</text>
      <rect class="chip" x="322" y="218" width="126" height="22" rx="4"></rect>
      <text class="chip-text lbl-amber" x="385" y="233">asection</text>
      <rect class="chip" x="468" y="218" width="126" height="22" rx="4"></rect>
      <text class="chip-text lbl-amber" x="531" y="233">asymbol</text>
    </g>
    <text class="sub" x="385" y="256">bfd_openr · bfd_check_format · bfd_canonicalize_symtab</text>
    <text class="sub" x="385" y="270">bfd_section_vma · bfd_get_section_contents · bfd_close</text>

    <!-- back-ends -->
    <rect class="box proc-blue" x="150" y="298" width="470" height="62" rx="6"></rect>
    <text class="title lbl-blue" x="385" y="318">libbfd back-ends · one per target</text>
    <g>
      <rect class="chip" x="168" y="328" width="130" height="20" rx="4"></rect>
      <text class="chip-text" x="233" y="342">elf64-x86-64</text>
      <rect class="chip" x="306" y="328" width="120" height="20" rx="4"></rect>
      <text class="chip-text" x="366" y="342">pei-x86-64</text>
      <rect class="chip" x="434" y="328" width="110" height="20" rx="4"></rect>
      <text class="chip-text" x="489" y="342">elf32-i386</text>
      <text class="sub" x="580" y="342">…</text>
    </g>

    <!-- files -->
    <rect class="box box-plain" x="150" y="376" width="470" height="30" rx="6"></rect>
    <text class="sub" x="385" y="395">a.out (ELF64) · hello.exe (PE32+) · /bin/ls · …</text>

    <!-- flow arrows -->
    <line class="flow" x1="120" y1="49" x2="120" y2="126" marker-end="url(#ls-arrow)"></line>
    <line class="flow" x1="120" y1="150" x2="120" y2="228" marker-end="url(#ls-arrow)"></line>
    <line class="flow" x1="120" y1="252" x2="120" y2="326" marker-end="url(#ls-arrow)"></line>
    <line class="flow" x1="120" y1="350" x2="120" y2="390" marker-end="url(#ls-arrow)"></line>

    <!-- side notes -->
    <line class="tick" x1="620" y1="112" x2="644" y2="112"></line>
    <text class="note lbl-teal" x="650" y="104">THE ABSTRACTION BOUNDARY</text>
    <text class="note" x="650" y="120">no bfd type crosses this line,</text>
    <text class="note" x="650" y="136">loader.h includes no bfd.h</text>

    <line class="tick" x1="620" y1="216" x2="644" y2="216"></line>
    <text class="note" x="650" y="212">generic structures: the same</text>
    <text class="note" x="650" y="228">asection describes an ELF</text>
    <text class="note" x="650" y="244">section and a PE section</text>

    <line class="tick" x1="620" y1="326" x2="644" y2="326"></line>
    <text class="note" x="650" y="322">a new format = a new back-end</text>
    <text class="note" x="650" y="338">here; nothing above changes</text>

    <text class="key" x="385" y="16">↓ each layer only talks to the one below it ↓</text>
  </svg>
  <span slot="caption">
    Why libbfd is worth the awkward API: it collapses every binary format into one set of
    structures. The loader copies what it needs into its own classes, so everything above the
    teal line stays format-agnostic, and gets PE support for free.
  </span>
</FigureFrame>

<style>
  text {
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    text-anchor: middle;
  }

  .grid-dot {
    fill: var(--border);
    opacity: 0.5;
  }

  .box {
    fill: var(--bg-1);
    stroke-width: 1.25;
    stroke-opacity: 0.75;
  }

  .box-plain {
    stroke: var(--border);
    stroke-opacity: 1;
  }

  .proc-green {
    stroke: var(--green);
  }

  .proc-teal {
    stroke: var(--teal);
  }

  .proc-amber {
    stroke: var(--amber);
  }

  .proc-blue {
    stroke: var(--blue);
  }

  .title {
    font-size: 13px;
    font-weight: 600;
  }

  .lbl-green {
    fill: var(--green);
  }

  .lbl-teal {
    fill: var(--teal);
  }

  .lbl-amber {
    fill: var(--amber);
  }

  .lbl-blue {
    fill: var(--blue);
  }

  .sub {
    fill: var(--text-faint);
    font-size: 10px;
  }

  .chip {
    fill: var(--bg-2);
    stroke: var(--border);
    stroke-width: 1;
  }

  .chip-text {
    fill: var(--text-muted);
    font-size: 11px;
  }

  .tick {
    stroke: var(--border);
    stroke-width: 1;
  }

  .note {
    fill: var(--text-faint);
    font-size: 10.5px;
    text-anchor: start;
  }

  .note.lbl-teal {
    fill: var(--teal);
    letter-spacing: 0.06em;
    font-size: 10px;
  }

  .flow {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.5;
    stroke-opacity: 0.7;
  }

  .key {
    fill: var(--text-faint);
    font-size: 10px;
  }

  .arrow-head {
    fill: var(--text-faint);
    fill-opacity: 0.7;
  }
</style>
