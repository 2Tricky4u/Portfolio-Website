---
type Accent = 'red' | 'teal' | 'amber' | 'blue' | 'green' | 'muted';

interface Series {
  key: string;
  label: string;
  accent?: Accent;
}

interface Row {
  label: string;
  values: Record<string, number>;
}

interface Props {
  data: Row[];
  series: Series[];
  /** X-axis max. Defaults to the largest value with ~15% headroom. */
  max?: number;
  /** Suffix appended to every value label, e.g. "×" or "%". */
  unit?: string;
  /** Draw a dashed reference line at this value (e.g. 1 for a 1.0× baseline). */
  baseline?: number;
  baselineLabel?: string;
  caption?: string;
}

const { data, series, max, unit = '', baseline, baselineLabel, caption } = Astro.props;

const dataMax = Math.max(
  ...data.flatMap((r) => series.map((s) => r.values[s.key] ?? 0))
);
const axisMax = max ?? dataMax * 1.15;
const fmt = (v: number) => `${Number.isInteger(v) ? v : v.toFixed(1)}${unit}`;
const baselineFrac = baseline != null ? baseline / axisMax : null;
---

<figure class="chart-fig">
  <ul class="legend mono">
    {
      series.map((s) => (
        <li>
          <span class:list={['swatch', s.accent ?? 'muted']} aria-hidden="true" />
          {s.label}
        </li>
      ))
    }
  </ul>

  <div class="chart" style={baselineFrac != null ? `--baseline-frac:${baselineFrac}` : ''}>
    {
      baselineFrac != null && (
        <div class="baseline" aria-hidden="true">
          {baselineLabel && <span class="baseline-tag mono">{baselineLabel}</span>}
        </div>
      )
    }
    {
      data.map((r) => (
        <div class="row">
          <div class="row-label mono">{r.label}</div>
          <div class="row-bars">
            {series.map((s) => {
              const v = r.values[s.key];
              if (v == null) return null;
              const pct = Math.max(0, (v / axisMax) * 100);
              return (
                <div class="track">
                  <div
                    class:list={['bar', s.accent ?? 'muted']}
                    style={`width:${pct}%`}
                    title={`${r.label} — ${s.label}: ${fmt(v)}`}
                  />
                  <span class="val mono">{fmt(v)}</span>
                </div>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>

  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .chart-fig {
    margin: 0;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--accent, var(--text-faint));
  }

  .chart {
    position: relative;
    --label-w: 6.5rem;
  }

  .baseline {
    position: absolute;
    top: 0;
    bottom: 1.2rem;
    left: calc(var(--label-w) + (100% - var(--label-w)) * var(--baseline-frac));
    width: 0;
    border-left: 1px dashed var(--text-faint);
    z-index: 1;
  }

  .baseline-tag {
    position: absolute;
    top: -1.1rem;
    left: 2px;
    color: var(--text-faint);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .row {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .row-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .row-bars {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .track {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .bar {
    height: 0.85rem;
    min-width: 2px;
    border-radius: 2px;
    background: var(--accent, var(--text-faint));
    flex: 0 0 auto;
  }

  .val {
    font-size: var(--text-xs);
    color: var(--text-faint);
    flex: 0 0 auto;
  }

  .swatch.red,
  .bar.red {
    --accent: var(--red-soft);
  }
  .swatch.teal,
  .bar.teal {
    --accent: var(--teal);
  }
  .swatch.amber,
  .bar.amber {
    --accent: var(--amber);
  }
  .swatch.blue,
  .bar.blue {
    --accent: var(--blue);
  }
  .swatch.green,
  .bar.green {
    --accent: var(--green);
  }
  .swatch.muted,
  .bar.muted {
    --accent: var(--text-faint);
  }

  figcaption {
    margin-top: var(--space-4);
    color: var(--text-faint);
    text-align: center;
    font-size: var(--text-xs);
  }

  @media (max-width: 560px) {
    .chart {
      --label-w: 4.5rem;
    }
  }
</style>
